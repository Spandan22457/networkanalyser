# Copy to ".env" and edit. Every value is optional.
#
# Leave NETSCOPE_DATABASE_URL commented out to use the local SQLite file,
# which is the zero-setup default.

# PostgreSQL example. The "+psycopg" driver is required; psycopg is the
# installed driver and the URL is upgraded automatically if you leave it out.
# NETSCOPE_DATABASE_URL=postgresql+psycopg://netscope:CHANGE_ME@127.0.0.1:5432/netscope

# SQLite (default). Absolute path, so the working directory never matters.
# NETSCOPE_DATABASE_PATH=C:\path\to\network_monitor.db
# NETSCOPE_SQLITE_BUSY_TIMEOUT_MS=5000
# NETSCOPE_ENABLE_WAL=1

# Connection pool for a server database.
# NETSCOPE_DB_POOL_SIZE=5
# NETSCOPE_DB_MAX_OVERFLOW=5
# NETSCOPE_DB_POOL_RECYCLE=1800
